import { Directive } from '@angular/core';
import { classes } from '@spartan-ng/helm/utils';

@Directive({
	selector: '[hlmToolCallArgs],hlm-tool-call-args',
	exportAs: 'hlmToolCallArgs',
	host: {
		'data-slot': 'tool-call-args',
	},
})
export class HlmToolCallArgs {
	constructor() {
		classes(
			() =>
				'spartan-tool-call-args border-t border-border/50 px-3 py-2 text-xs text-muted-foreground group-data-[expanded=false]/tool-call:hidden',
		);
	}
}
