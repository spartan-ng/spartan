{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"outDir": "../../dist/out-tsc",
		"declaration": true,
		"declarationMap": true,
		"inlineSources": true,
		"types": [],
		"moduleResolution": "bundler"
	},
	"exclude": [
		"**/*.spec.ts",
		"test-setup.ts",
		"vite.config.mts",
		"**/*.test.ts",
		"data-grid/**/*.spec.ts",
		"data-grid/**/*.test.ts"
	],
	"include": ["**/*.ts", "data-grid/**/*.ts"]
}
